// Generated by `garrison polkit-rule`; do not edit by hand. After changing
// [[actions]] in garrison.toml, run `garrison access update`, which gives the
// profiles the actions as they are now, and then the installer, which writes
// this file anew.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" ||
        subject.user !== "garrison-broker") {
        return polkit.Result.NOT_HANDLED;
    }
    var allowed = {"backup.service": ["start"], "monitor.service": ["start"]};
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (Object.prototype.hasOwnProperty.call(allowed, unit) &&
        allowed[unit].indexOf(verb) !== -1) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
