[Unit]
Description=Garrison - status collection
After=network.target

[Service]
Type=oneshot
User=garrison-collector
Group=garrison
ExecStart=/opt/garrison/current/bin/garrison collect
LoadCredential=collector-native-key:/etc/garrison/credentials/collector-native-key
# Stalwart's metrics exporter's user and password, which setup writes where
# the exporter is Garrison's; an empty file, which the installer keeps,
# means none.
LoadCredential=metrics-credential:/etc/garrison/credentials/metrics-credential
# The key of Spamhaus' Data Query Service, for its lists written without it
# (collector.dqs_key); an empty file, which the installer keeps, means none.
LoadCredential=spamhaus-dqs-key:/etc/garrison/credentials/spamhaus-dqs-key
# The access token of the notification topic; the installer keeps an empty
# file there, since systemd refuses a unit whose credential is missing.
LoadCredential=ntfy-token:/etc/garrison/credentials/ntfy-token
# The webhook's token and the password of the account that submits mail;
# empty files, which the installer keeps, mean that neither is used.
LoadCredential=notify-webhook-token:/etc/garrison/credentials/notify-webhook-token
LoadCredential=notify-mail-password:/etc/garrison/credentials/notify-mail-password
# The topic's and the webhook's address, where it is a secret itself and the
# configuration names the file (credential:ntfy-url); empty files otherwise.
LoadCredential=ntfy-url:/etc/garrison/credentials/ntfy-url
LoadCredential=notify-webhook-url:/etc/garrison/credentials/notify-webhook-url
StateDirectory=garrison/collector
StateDirectoryMode=0750
UMask=0027
# A run that is ended here stores nothing. The collector keeps a shorter
# time of its own: no check begins after 70 seconds, the notifications are
# given up at 100, and the snapshot is written with what was found.
TimeoutStartSec=120
# Providers read host files (configuration, receipts) but never write them.
ReadOnlyPaths=/var/lib/garrison/ingest
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectHostname=true
# The version commands of `version-command` providers run in this sandbox too,
# so they cannot load code at run time (as a JIT would) either.
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
TasksMax=32
Nice=10
