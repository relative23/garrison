[Unit]
Description=Garrison - status collection
After=network.target

[Service]
Type=oneshot
User=garrison-collector
Group=garrison
ExecStart=/opt/garrison/current/bin/garrison collect
LoadCredential=collector-native-key:/etc/garrison/credentials/collector-native-key
LoadCredential=metrics-credential:/etc/garrison/credentials/metrics-credential
# The access token of the notification topic; the installer keeps an empty
# file there, since systemd refuses a unit whose credential is missing.
LoadCredential=ntfy-token:/etc/garrison/credentials/ntfy-token
# The webhook's token and the password of the account that submits mail;
# empty files, which the installer keeps, mean that neither is used.
LoadCredential=notify-webhook-token:/etc/garrison/credentials/notify-webhook-token
LoadCredential=notify-mail-password:/etc/garrison/credentials/notify-mail-password
StateDirectory=garrison/collector
StateDirectoryMode=0750
UMask=0027
TimeoutStartSec=120
# Providers read host files (configuration, receipts) but never write them.
ReadOnlyPaths=/var/lib/garrison/ingest
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectHostname=true
# The version commands of `version-command` providers run in this sandbox too,
# so they cannot load code at run time (as a JIT would) either.
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
TasksMax=32
Nice=10
