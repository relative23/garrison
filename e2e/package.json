{
  "name": "garrison-e2e",
  "private": true,
  "type": "module",
  "description": "Browser checks of the interface against the preview: what a user does (flows), Lighthouse and axe measurements, and the README's screenshots.",
  "scripts": {
    "flows": "node flows.mjs",
    "measure": "node measure.mjs",
    "screenshots": "node screenshots.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.6.0",
    "playwright": "1.64.1"
  },
  "overrides": {
    "@sentry/bundler-plugins": {
      "glob": {
        ".": "14.0.2",
        "minimatch": "11.0.1"
      }
    }
  }
}
